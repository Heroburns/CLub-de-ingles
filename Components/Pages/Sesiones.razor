@page "/sesiones"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Coordinador)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ClubIngles.Data
@using ClubIngles.Data.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Sesiones</PageTitle>

<h1>Sesiones</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@(form.IdSesion == 0 ? "Nueva sesión" : "Editar sesión")</h5>
        <EditForm Model="form" OnValidSubmit="Guardar" FormName="sesion">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fecha</label>
                    <InputDate class="form-control" @bind-Value="form.Fecha" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Semana</label>
                    <InputNumber class="form-control" @bind-Value="form.Semana" />
                    <ValidationMessage For="() => form.Semana" />
                </div>
                <div class="col-md-7">
                    <label class="form-label">Tema</label>
                    <InputText class="form-control" @bind-Value="form.Tema" />
                    <ValidationMessage For="() => form.Tema" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
                @if (form.IdSesion != 0)
                {
                    <button type="button" class="btn btn-secondary ms-2" @onclick="Limpiar">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (sesiones is null)
{
    <p><em>Cargando...</em></p>
}
else if (sesiones.Count == 0)
{
    <p>Todavía no hay sesiones.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Semana</th>
                <th>Fecha</th>
                <th>Tema</th>
                <th>Asistieron</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in sesiones)
            {
                <tr>
                    <td>@s.Semana</td>
                    <td>@s.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@s.Tema</td>
                    <td>@s.Asistencias.Count(a => a.Estado != EstadoAsistencia.Ausente) / @s.Asistencias.Count</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-success" href="asistencia/@s.IdSesion">Asistencia</a>
                        <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => Editar(s)">Editar</button>
                        @if (confirmarBorrar == s.IdSesion)
                        {
                            <button class="btn btn-sm btn-danger ms-1" @onclick="() => Borrar(s.IdSesion)">¿Seguro? Borrar</button>
                            <button class="btn btn-sm btn-secondary ms-1" @onclick="() => confirmarBorrar = 0">No</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => confirmarBorrar = s.IdSesion">Borrar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Sesion>? sesiones;
    private Sesion form = new();
    private int confirmarBorrar = 0;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        using var db = DbFactory.CreateDbContext();
        sesiones = await db.Sesiones.Include(s => s.Asistencias)
            .OrderBy(s => s.Fecha).ToListAsync();
    }

    private async Task Guardar()
    {
        using var db = DbFactory.CreateDbContext();
        if (form.IdSesion == 0) db.Sesiones.Add(form);
        else db.Sesiones.Update(form);
        await db.SaveChangesAsync();
        Limpiar();
        await Cargar();
    }

    private void Editar(Sesion s) =>
        form = new Sesion { IdSesion = s.IdSesion, Fecha = s.Fecha, Semana = s.Semana, Tema = s.Tema };

    private void Limpiar() => form = new Sesion();

    private async Task Borrar(int id)
    {
        using var db = DbFactory.CreateDbContext();
        var s = await db.Sesiones.FindAsync(id);
        if (s is not null)
        {
            db.Sesiones.Remove(s);   // también borra su asistencia
            await db.SaveChangesAsync();
        }
        confirmarBorrar = 0;
        if (form.IdSesion == id) Limpiar();
        await Cargar();
    }
}
